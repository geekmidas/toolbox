PORT=3000
NODE_ENV=development

# Nothing else belongs here. Every address and every credential this app uses is
# declared by a construct and injected by `gkm dev` / `gkm exec` from what it
# reconciled: KITCHEN_SINK_URL, AUTH_DB_URL, AUTH_SECRET, SESSIONS_URL,
# UPLOADS_URL, MAIL_URL, MAIL_FROM, and the broker strings for the `emails`
# queue and the `users` topic. Writing one of them here would override the port
# that was actually allocated.
