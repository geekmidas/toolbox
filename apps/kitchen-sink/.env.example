PORT=3000
NODE_ENV=development

# Auth (mock) — see src/services/AuthService.ts
JWT_SECRET=dev-secret
JWT_ISSUER=kitchen-sink

# Nothing else belongs here. Every address this app uses is declared by a
# construct and injected by `gkm dev` / `gkm exec` from the containers it
# reconciled: KITCHEN_SINK_URL, UPLOADS_URL, MAIL_URL, MAIL_FROM, and the
# broker strings for the `emails` queue and the `users` topic. Writing one of
# them here would override the port that was actually allocated.
