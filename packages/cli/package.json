{
	"name": "@geekmidas/cli",
	"version": "10.0.0-alpha.6",
	"description": "CLI tools for building Lambda handlers, server applications, and generating OpenAPI specs",
	"private": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./config": {
			"import": {
				"types": "./dist/config.d.mts",
				"default": "./dist/config.mjs"
			},
			"require": {
				"types": "./dist/config.d.cts",
				"default": "./dist/config.cjs"
			}
		},
		"./reconcile": {
			"import": {
				"types": "./dist/reconcile/public.d.mts",
				"default": "./dist/reconcile/public.mjs"
			},
			"require": {
				"types": "./dist/reconcile/public.d.cts",
				"default": "./dist/reconcile/public.cjs"
			}
		},
		"./workspace": {
			"import": {
				"types": "./dist/workspace/index.d.mts",
				"default": "./dist/workspace/index.mjs"
			},
			"require": {
				"types": "./dist/workspace/index.d.cts",
				"default": "./dist/workspace/index.cjs"
			}
		},
		"./openapi": {
			"import": {
				"types": "./dist/openapi.d.mts",
				"default": "./dist/openapi.mjs"
			},
			"require": {
				"types": "./dist/openapi.d.cts",
				"default": "./dist/openapi.cjs"
			}
		},
		"./openapi-react-query": {
			"import": {
				"types": "./dist/openapi-react-query.d.mts",
				"default": "./dist/openapi-react-query.mjs"
			},
			"require": {
				"types": "./dist/openapi-react-query.d.cts",
				"default": "./dist/openapi-react-query.cjs"
			}
		}
	},
	"files": [
		"dist",
		"bin"
	],
	"bin": {
		"gkm": "./bin/gkm.mjs"
	},
	"scripts": {
		"ts": "tsc --noEmit --skipLibCheck src/**/*.ts",
		"sync-versions": "tsx scripts/sync-versions.ts",
		"prebuild": "pnpm sync-versions",
		"test": "vitest",
		"test:once": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/geekmidas/toolbox"
	},
	"dependencies": {
		"@apidevtools/swagger-parser": "~13.1.0",
		"@aws-sdk/client-iam": "~3.1136.0",
		"@aws-sdk/client-route-53": "~3.1136.0",
		"@aws-sdk/client-s3": "~3.1136.0",
		"@aws-sdk/client-ssm": "~3.1136.0",
		"@aws-sdk/credential-providers": "~3.1136.0",
		"@geekmidas/cache": "workspace:*",
		"@geekmidas/constructs": "workspace:~",
		"@geekmidas/db": "workspace:*",
		"@geekmidas/envkit": "workspace:~",
		"@geekmidas/errors": "workspace:~",
		"@geekmidas/logger": "workspace:~",
		"@geekmidas/manifest": "workspace:*",
		"@geekmidas/schema": "workspace:~",
		"chokidar": "~5.0.0",
		"commander": "~15.0.0",
		"dotenv": "~18.0.1",
		"esbuild": "~0.28.2",
		"fast-glob": "~3.3.3",
		"hono": "~4.13.8",
		"lodash.kebabcase": "~4.1.1",
		"openapi-typescript": "~7.13.0",
		"pg": "~8.23.0",
		"prompts": "~2.4.2",
		"tsx": "~4.20.3",
		"yaml": "~2.9.1"
	},
	"devDependencies": {
		"@geekmidas/testkit": "workspace:*",
		"@types/lodash.kebabcase": "~4.1.9",
		"@types/node": "~24.9.1",
		"@types/pg": "~8.23.1",
		"@types/prompts": "~2.4.9",
		"typescript": "^5.8.2",
		"vitest": "^3.2.4",
		"zod": "~4.6.5"
	},
	"peerDependencies": {
		"@geekmidas/telescope": "workspace:~"
	},
	"peerDependenciesMeta": {
		"@geekmidas/telescope": {
			"optional": true
		}
	}
}
