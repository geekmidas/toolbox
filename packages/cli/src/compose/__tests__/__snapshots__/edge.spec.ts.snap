exports[`the edge > redirects HTTP to HTTPS, answers ACME, and watches one directory 1`] = `
{
  "certificatesResolvers": {
    "letsencrypt": {
      "acme": {
        "httpChallenge": {
          "entryPoint": "web",
        },
        "storage": "/acme/acme.json",
      },
    },
  },
  "entryPoints": {
    "ping": {
      "address": ":8082",
    },
    "web": {
      "address": ":80",
      "http": {
        "redirections": {
          "entryPoint": {
            "permanent": true,
            "scheme": "https",
            "to": "websecure",
          },
        },
      },
    },
    "websecure": {
      "address": ":443",
    },
  },
  "global": {
    "checkNewVersion": false,
    "sendAnonymousUsage": false,
  },
  "log": {
    "level": "INFO",
  },
  "ping": {
    "entryPoint": "ping",
  },
  "providers": {
    "file": {
      "directory": "/etc/gkm-edge/dynamic",
      "watch": true,
    },
  },
}
`;

exports[`the route model, rendered for Caddy > renders every route as a site block 1`] = `
"# Generated by gkm compose from the construct manifest — do not edit.
#
# One host per API and site, each in front of its own container, one per
# file server in front of the stack's MinIO, and — when its logs are served
# publicly — one for OpenObserve, to the addresses it allows.
https://api.shop.example.com {
	# gkm's own header, which only a service of this stack may send: the auth
	# server rate-limits by the client address it carries.
	request_header -x-gkm-client-ip

	# Host and X-Forwarded-* are passed through as Caddy does by default, so
	# an app builds redirects, cookies and links on the address a caller used.
	reverse_proxy api:3000 {
		# Never buffer: a streamed response — server-sent events, a Next.js
		# RSC payload — reaches the client as each chunk is written.
		flush_interval -1
	}
}

https://shop.example.com {
	# gkm's own header, which only a service of this stack may send: the auth
	# server rate-limits by the client address it carries.
	request_header -x-gkm-client-ip

	# Host and X-Forwarded-* are passed through as Caddy does by default, so
	# an app builds redirects, cookies and links on the address a caller used.
	reverse_proxy web:3002 {
		# Never buffer: a streamed response — server-sent events, a Next.js
		# RSC payload — reaches the client as each chunk is written.
		flush_interval -1
	}
}

https://uploads-server.shop.example.com {
	# gkm's own header, which only a service of this stack may send: the auth
	# server rate-limits by the client address it carries.
	request_header -x-gkm-client-ip

	# A bucket, served at a host of its own: the bucket is a prefix on MinIO,
	# which routes and signs on the Host header — so it is sent the upstream's.
	reverse_proxy minio:9000 {
		rewrite /uploads{uri}
		header_up Host {upstream_hostport}
	}
}

https://logs.shop.example.com {
	# gkm's own header, which only a service of this stack may send: the auth
	# server rate-limits by the client address it carries.
	request_header -x-gkm-client-ip

	# Only these addresses — the peer Caddy sees, never a header a client
	# could set. Everything else is refused before it reaches the upstream.
	@denied not remote_ip 203.0.113.7 10.0.0.0/8
	respond @denied 403

	# Host and X-Forwarded-* are passed through as Caddy does by default, so
	# an app builds redirects, cookies and links on the address a caller used.
	reverse_proxy openobserve:5080 {
		# Never buffer: a streamed response — server-sent events, a Next.js
		# RSC payload — reaches the client as each chunk is written.
		flush_interval -1
	}
}
"
`;

exports[`the route model, rendered for Traefik > renders routers, services and middlewares 1`] = `
{
  "http": {
    "middlewares": {
      "shop-production-files-uploads-server-prefix": {
        "addPrefix": {
          "prefix": "/uploads",
        },
      },
      "shop-production-openobserve-allow": {
        "ipAllowList": {
          "sourceRange": [
            "203.0.113.7",
            "10.0.0.0/8",
          ],
        },
      },
      "shop-production-strip-gkm-headers": {
        "headers": {
          "customRequestHeaders": {
            "x-gkm-client-ip": "",
          },
        },
      },
    },
    "routers": {
      "shop-production-api": {
        "entryPoints": [
          "websecure",
        ],
        "middlewares": [
          "shop-production-strip-gkm-headers",
        ],
        "rule": "Host(\`api.shop.example.com\`)",
        "service": "shop-production-api",
        "tls": {
          "certResolver": "letsencrypt",
        },
      },
      "shop-production-files-uploads-server": {
        "entryPoints": [
          "websecure",
        ],
        "middlewares": [
          "shop-production-strip-gkm-headers",
          "shop-production-files-uploads-server-prefix",
        ],
        "rule": "Host(\`uploads-server.shop.example.com\`)",
        "service": "shop-production-files-uploads-server",
        "tls": {
          "certResolver": "letsencrypt",
        },
      },
      "shop-production-openobserve": {
        "entryPoints": [
          "websecure",
        ],
        "middlewares": [
          "shop-production-strip-gkm-headers",
          "shop-production-openobserve-allow",
        ],
        "rule": "Host(\`logs.shop.example.com\`)",
        "service": "shop-production-openobserve",
        "tls": {
          "certResolver": "letsencrypt",
        },
      },
      "shop-production-web": {
        "entryPoints": [
          "websecure",
        ],
        "middlewares": [
          "shop-production-strip-gkm-headers",
        ],
        "rule": "Host(\`shop.example.com\`)",
        "service": "shop-production-web",
        "tls": {
          "certResolver": "letsencrypt",
        },
      },
    },
    "services": {
      "shop-production-api": {
        "loadBalancer": {
          "healthCheck": {
            "interval": "5s",
            "path": "/health",
            "timeout": "3s",
          },
          "responseForwarding": {
            "flushInterval": "-1ms",
          },
          "servers": [
            {
              "url": "http://shop-production-api:3000",
            },
          ],
        },
      },
      "shop-production-files-uploads-server": {
        "loadBalancer": {
          "passHostHeader": false,
          "servers": [
            {
              "url": "http://shop-production-minio:9000",
            },
          ],
        },
      },
      "shop-production-openobserve": {
        "loadBalancer": {
          "responseForwarding": {
            "flushInterval": "-1ms",
          },
          "servers": [
            {
              "url": "http://shop-production-openobserve:5080",
            },
          ],
        },
      },
      "shop-production-web": {
        "loadBalancer": {
          "healthCheck": {
            "interval": "5s",
            "path": "/",
            "timeout": "3s",
          },
          "responseForwarding": {
            "flushInterval": "-1ms",
          },
          "servers": [
            {
              "url": "http://shop-production-web:3002",
            },
          ],
        },
      },
    },
  },
}
`;
